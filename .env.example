# Supabase Dashboard -> Connect -> Session pooler
APPLICATION_NAME=FitLink
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR_SUPABASE_PROJECT_REF
DATABASE_PASSWORD=CHANGE_ME_SUPABASE_DATABASE_PASSWORD

# Generate a strong value with at least 32 random bytes
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Google Sign-In (Sign in with Google)
# Use the Web OAuth 2.0 Client ID as the backend audience. Android/iOS client IDs
# are configured separately in the Google Cloud console and are NOT secrets.
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_CLIENT_ID
# Optional. Defaults to true. Reject Google accounts whose email is not verified by Google.
GOOGLE_REQUIRE_VERIFIED_EMAIL=true

# Gmail SMTP (use a Google App Password, not the account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS
MAIL_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# HikariCP
DB_POOL_NAME=FitLinkHikariPool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# Hibernate
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
HIBERNATE_JDBC_BATCH_SIZE=20
HIBERNATE_ORDER_INSERTS=true
HIBERNATE_ORDER_UPDATES=true

# Proxy and logging
FORWARD_HEADERS_STRATEGY=framework
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APPLICATION=INFO
LOG_LEVEL_SECURITY=DEBUG

# Supabase Storage (S3-compatible API)
# Find the endpoint/keys in Supabase Dashboard -> Storage -> Settings.
SUPABASE_S3_ENDPOINT=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=CHANGE_ME_SUPABASE_S3_ACCESS_KEY
SUPABASE_S3_SECRET_KEY=CHANGE_ME_SUPABASE_S3_SECRET_KEY
SUPABASE_S3_BUCKET=CHANGE_ME_STORAGE_BUCKET_NAME

# Public base URL of the Supabase project (used to build public object URLs)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co

# Multipart upload limits
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=20MB
SUPABASE_STORAGE_MAX_FILE_SIZE_BYTES=10485760
